{
  "name": "ignite-music-desktop",
  "version": "1.0.0",
  "description": "Desktop Launcher and Service Supervisor for Ignite Music",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "prebuild": "node scripts/ensure-node.js && node scripts/bundle-service.js",
    "predist": "npm run prebuild",
    "predist:win": "npm run prebuild",
    "predist:linux": "node scripts/bundle-service.js",
    "prepack": "npm run prebuild",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "keywords": [
    "ignite",
    "music",
    "electron",
    "discord-bot",
    "launcher"
  ],
  "author": "DeibydBarragan",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3"
  }
}
